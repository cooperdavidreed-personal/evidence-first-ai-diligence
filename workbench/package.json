{
  "name": "underwriting-intelligence-lab-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:chunks": "node scripts/verify-case-chunks.mjs",
    "test": "vitest run",
    "test:mcp": "node --test mcp-server/server.test.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm test:mcp && pnpm build && pnpm verify:chunks && pnpm test:e2e"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "ai": "^7.0.86",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
}

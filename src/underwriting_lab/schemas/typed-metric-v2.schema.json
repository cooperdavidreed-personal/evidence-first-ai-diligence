{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Underwriting typed metric v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_id", "label", "value", "display_value", "unit", "quantum", "currency", "period", "classification", "source_locator_ids", "formula_id", "operand_ids", "assumption_ids", "downstream_ids", "governing_receipt_sha256", "state", "metric_sha256"],
  "properties": {
    "metric_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "value": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "display_value": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "quantum": {"type": "string", "pattern": "^0?\\.[0-9]*[1-9][0-9]*$|^[1-9][0-9]*$"},
    "currency": {"type": ["string", "null"]},
    "period": {"type": "string", "minLength": 1},
    "classification": {"enum": ["ACCOUNTING_IDENTITY", "DESCRIPTIVE", "PREDICTIVE_ASSOCIATION", "CAUSAL_SYNTHETIC_ONLY", "SCENARIO", "NOT_IDENTIFIED", "HUMAN_JUDGMENT"]},
    "source_locator_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "formula_id": {"type": ["string", "null"]},
    "operand_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "assumption_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "downstream_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "governing_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["CURRENT", "STALE"]},
    "metric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

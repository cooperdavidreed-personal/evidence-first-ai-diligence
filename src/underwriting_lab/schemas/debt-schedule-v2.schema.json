{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Underwriting debt schedule v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_inputs_sha256", "months", "ending_debt_cents", "minimum_liquidity_cents", "first_covenant_breach_month", "has_payment_default", "reconciliation", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.debt-schedule/v2"},
    "engine_inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "months": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["month", "beginning_cash_cents", "beginning_term_cents", "beginning_revolver_cents", "cash_interest_cents", "pik_interest_cents", "cash_taxes_cents", "mandatory_amortization_cents", "revolver_draw_cents", "optional_sweep_cents", "ending_cash_cents", "ending_term_cents", "ending_revolver_cents", "trailing_lender_ebitda_cents", "gross_leverage", "covenant_headroom", "covenant_breach", "payment_default"],
        "properties": {
          "month": {"type": "integer", "minimum": 1},
          "beginning_cash_cents": {"type": "integer"}, "beginning_term_cents": {"type": "integer", "minimum": 0}, "beginning_revolver_cents": {"type": "integer", "minimum": 0},
          "cash_interest_cents": {"type": "integer", "minimum": 0}, "pik_interest_cents": {"type": "integer", "minimum": 0}, "cash_taxes_cents": {"type": "integer", "minimum": 0},
          "mandatory_amortization_cents": {"type": "integer", "minimum": 0}, "revolver_draw_cents": {"type": "integer", "minimum": 0}, "optional_sweep_cents": {"type": "integer", "minimum": 0},
          "ending_cash_cents": {"type": "integer"}, "ending_term_cents": {"type": "integer", "minimum": 0}, "ending_revolver_cents": {"type": "integer", "minimum": 0},
          "trailing_lender_ebitda_cents": {"type": "integer", "exclusiveMinimum": 0},
          "gross_leverage": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}, "covenant_headroom": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
          "covenant_breach": {"type": "boolean"}, "payment_default": {"type": "boolean"}
        }
      }
    },
    "ending_debt_cents": {"type": "integer", "minimum": 0},
    "minimum_liquidity_cents": {"type": "integer"},
    "first_covenant_breach_month": {"type": ["integer", "null"], "minimum": 1},
    "has_payment_default": {"type": "boolean"},
    "reconciliation": {"type": "object", "additionalProperties": false, "required": ["cash_rollforward_max_residual_cents", "term_rollforward_max_residual_cents", "revolver_rollforward_max_residual_cents", "cash_interest_max_residual_cents", "covenant_status_mismatches"], "properties": {"cash_rollforward_max_residual_cents": {"type": "integer", "minimum": 0}, "term_rollforward_max_residual_cents": {"type": "integer", "minimum": 0}, "revolver_rollforward_max_residual_cents": {"type": "integer", "minimum": 0}, "cash_interest_max_residual_cents": {"type": "integer", "minimum": 0}, "covenant_status_mismatches": {"type": "integer", "minimum": 0}}},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

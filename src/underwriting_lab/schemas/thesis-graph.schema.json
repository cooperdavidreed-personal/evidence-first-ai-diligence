{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cooperdavidreed-personal.github.io/evidence-first-ai-diligence/schemas/thesis-graph.schema.json",
  "title": "Underwriting thesis graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "nodes", "edges", "graph_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.thesis-graph/v1"},
    "case_id": {"enum": ["atlasgrid", "helios"]},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

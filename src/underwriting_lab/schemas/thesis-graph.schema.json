{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cooperdavidreed-personal.github.io/evidence-first-ai-diligence/schemas/thesis-graph.schema.json",
  "title": "Underwriting thesis graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "nodes", "edges", "graph_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.thesis-graph/v1"},
    "case_id": {"enum": ["atlasgrid", "helios"]},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "kind", "label", "status", "references"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["EVIDENCE", "ASSUMPTION", "ESTIMATE", "FALSIFIER", "SCENARIO", "DECISION", "INITIATIVE"]},
          "label": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "references": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "relationship": {"enum": ["SUPPORTS", "INFORMS", "CHALLENGES", "STRESSES", "CONDITIONS", "CONSTRAINS"]}
        }
      }
    },
    "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailyaiagents.dev/schemas/vc-distribution-v2.schema.json",
  "title": "VC Distribution v2",
  "type": "object",
  "required": ["schema_version", "seed", "draws", "base_result_receipt_sha256", "template_weights", "moic_quantiles", "xirr_quantiles", "probability_below_one", "probability_below_one_monte_carlo_se_pp", "priors", "path_records", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.vc-distribution/v2"},
    "seed": {"type": "integer"},
    "draws": {"type": "integer", "minimum": 500},
    "base_result_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "template_weights": {"type": "object", "minProperties": 4, "maxProperties": 4, "additionalProperties": {"type": "string"}},
    "moic_quantiles": {"type": "array", "minItems": 3, "maxItems": 3},
    "xirr_quantiles": {"type": "array", "minItems": 3, "maxItems": 3},
    "probability_below_one": {"type": "string"},
    "probability_below_one_monte_carlo_se_pp": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "priors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "catastrophe_probability", "catastrophe_exit_multiple_low", "catastrophe_exit_multiple_high", "continuous_exit_multiple_low", "continuous_exit_multiple_high", "continuous_exit_multiple_sigma", "exit_timing_mean_months", "exit_timing_sigma_months", "exit_timing_delta_min_months", "exit_timing_delta_max_months", "minimum_exit_month", "maximum_exit_month", "operating_cash_factor_mean", "operating_cash_factor_sigma", "operating_cash_factor_low", "operating_cash_factor_high", "shortfall_operating_cash_factor_high", "maximum_liquidity_extension_months", "loss_probability_band_low", "loss_probability_band_high", "rationale", "owner", "approval_status", "input_classification", "classification", "receipt_sha256"],
      "properties": {
        "schema_version": {"const": "underwriting.vc-distribution-priors/v1"},
        "catastrophe_probability": {"type": "string"},
        "catastrophe_exit_multiple_low": {"type": "string"},
        "catastrophe_exit_multiple_high": {"type": "string"},
        "continuous_exit_multiple_low": {"type": "string"},
        "continuous_exit_multiple_high": {"type": "string"},
        "continuous_exit_multiple_sigma": {"type": "string"},
        "exit_timing_mean_months": {"type": "string"},
        "exit_timing_sigma_months": {"type": "string"},
        "exit_timing_delta_min_months": {"type": "integer"},
        "exit_timing_delta_max_months": {"type": "integer"},
        "minimum_exit_month": {"type": "integer", "minimum": 1},
        "maximum_exit_month": {"type": "integer", "minimum": 1},
        "operating_cash_factor_mean": {"type": "string"},
        "operating_cash_factor_sigma": {"type": "string"},
        "operating_cash_factor_low": {"type": "string"},
        "operating_cash_factor_high": {"type": "string"},
        "shortfall_operating_cash_factor_high": {"type": "string"},
        "maximum_liquidity_extension_months": {"type": "integer", "minimum": 0},
        "loss_probability_band_low": {"type": ["string", "null"]},
        "loss_probability_band_high": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "approval_status": {"enum": ["UNREVIEWED", "APPROVED", "REJECTED"]},
        "input_classification": {"const": "ANALYST_SCENARIO_ASSUMPTION"},
        "classification": {"const": "SYNTHETIC_SCENARIO_NOT_FORECAST"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "path_records": {"type": "array", "minItems": 500},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

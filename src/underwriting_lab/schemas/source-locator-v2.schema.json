{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Underwriting source locator v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["locator_id", "artifact_id", "artifact_path", "artifact_sha256", "locator_kind", "selector", "period", "analysis_id", "retained_excerpt", "locator_sha256"],
  "properties": {
    "locator_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator_kind": {"enum": ["CSV_COLUMN_SET", "JSON_FIELDS", "TEXT_RANGE"]},
    "selector": {"type": "string", "minLength": 1},
    "period": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "retained_excerpt": {"type": "string", "minLength": 1},
    "locator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

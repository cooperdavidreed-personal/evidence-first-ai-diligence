{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Underwriting source locator v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locator_id", "artifact_id", "artifact_path", "repository_path", "published_path", "artifact_sha256", "locator_kind", "selector", "evidence_role", "period", "analysis_id", "selection_sha256", "retained_excerpt", "excerpt_sha256", "locator_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.source-locator/v3"},
    "locator_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "repository_path": {"type": "string", "pattern": "^portfolio/(atlasgrid|helios)/data-room/data/"},
    "published_path": {"type": "string", "pattern": "^source-pack/(atlasgrid|helios)/data/"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator_kind": {"enum": ["CSV_CELLS", "JSON_POINTERS", "TEXT_SPAN"]},
    "selector": {"type": "object", "minProperties": 1},
    "evidence_role": {"const": "ANALYSIS_INPUT"},
    "period": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 1},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retained_excerpt": {"type": "object", "minProperties": 1},
    "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Underwriting workbench case v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "caseId", "company", "caseType", "synthetic", "investmentAdjudication", "workflowDisposition", "disclosure", "dealContext", "decision", "summaryMetrics", "thesis", "chartRegistry", "teamAssessment", "ownershipCadence", "falsifierStates", "analyses", "distributionLineage", "scenarios", "returnsDistribution", "evidenceMappings", "valueCreation", "screenedOutLevers", "lineage", "artifacts", "temporalScan", "manifest_sha256", "scenarioBook", "thesisGraph", "sourceLocators", "formulaRegistry", "metricRegistry", "renderManifest", "analysis_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.workbench-case/v2"},
    "caseId": {"enum": ["atlasgrid", "helios"]},
    "company": {"type": "string", "minLength": 1},
    "caseType": {"type": "string", "minLength": 1},
    "synthetic": {"const": true},
    "investmentAdjudication": {"const": "PENDING_HUMAN"},
    "workflowDisposition": {"type": "string", "minLength": 1},
    "disclosure": {"const": "SYNTHETIC — NOT INVESTMENT ADVICE"},
    "dealContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "company_one_liner", "product", "customer", "market", "competition", "go_to_market", "team", "process", "evidence_boundary", "context_sha256"],
      "properties": {
        "schema_version": {"const": "underwriting.deal-context/v1"},
        "company_one_liner": {"type": "string", "minLength": 20},
        "product": {"type": "string", "minLength": 20},
        "customer": {"type": "string", "minLength": 20},
        "market": {"type": "string", "minLength": 20},
        "competition": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "go_to_market": {"type": "string", "minLength": 20},
        "team": {"type": "string", "minLength": 20},
        "process": {"type": "string", "minLength": 20},
        "evidence_boundary": {"type": "string", "minLength": 20},
        "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "decision": {"type": "object"},
    "summaryMetrics": {"type": "array", "minItems": 1},
    "thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "counterthesis", "drivers", "falsifiers", "requests"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "counterthesis": {"type": "string", "minLength": 1},
        "drivers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "falsifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requests": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["request_id", "request", "owner", "due_state", "materiality", "decision_consequence"],
            "properties": {
              "request_id": {"type": "string", "minLength": 1},
              "request": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "due_state": {"type": "string", "minLength": 1},
              "materiality": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
              "decision_consequence": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "chartRegistry": {
      "type": "array", "minItems": 3, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chart_id", "question", "conclusion", "uncertainty", "decision_dependency", "rendered_location"],
        "properties": {
          "chart_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "conclusion": {"type": "string", "minLength": 1},
          "uncertainty": {"type": "string", "minLength": 1},
          "decision_dependency": {"type": "string", "minLength": 1},
          "rendered_location": {"enum": ["IC Snapshot", "Thesis & Evidence", "Econometric Lab", "Underwriting Room", "Value Creation"]}
        }
      }
    },
    "teamAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["strengths", "unproven", "key_person_risk", "required_hires"],
      "properties": {
        "strengths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "unproven": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "key_person_risk": {"type": "string", "minLength": 1},
        "required_hires": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "ownershipCadence": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "timing", "owner", "milestone", "kpi", "stop_rule"],
        "properties": {
          "phase": {"enum": ["Pre-close", "Day 1", "Day 30", "Day 100", "Year 1"]},
          "timing": {"type": "string"}, "owner": {"type": "string"},
          "milestone": {"type": "string"}, "kpi": {"type": "string"}, "stop_rule": {"type": "string"}
        }
      }
    },
    "falsifierStates": {"type": "array"},
    "analyses": {"type": "array", "minItems": 1},
    "distributionLineage": {"type": "string"},
    "scenarios": {"type": "array", "minItems": 1},
    "returnsDistribution": {"type": "object"},
    "peEngine": {"type": "object"},
    "vcEngine": {
      "type": "object",
      "required": ["base", "milestone", "downside", "financing_shortfall", "distribution", "sensitivities", "milestone_contract", "exit_value_basis", "operating_exit_bridges"],
      "additionalProperties": false,
      "properties": {
        "base": {"type": "object"},
        "milestone": {"type": "object"},
        "downside": {"type": "object"},
        "financing_shortfall": {"type": "object"},
        "distribution": {"type": "object"},
        "sensitivities": {"type": "object"},
        "milestone_contract": {"type": "object"},
        "exit_value_basis": {"const": "EQUITY_VALUE"},
        "operating_exit_bridges": {
          "type": "object",
          "required": ["base", "milestone", "downside", "financing_shortfall"],
          "additionalProperties": false,
          "properties": {
            "base": {"type": "object"},
            "milestone": {"type": "object"},
            "downside": {"type": "object"},
            "financing_shortfall": {"type": "object"}
          }
        }
      }
    },
    "valueCreationBridge": {"type": "object"},
    "vcValueCreationBridge": {"type": "object"},
    "evidenceMappings": {"type": "array"},
    "valueCreation": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["priority", "initiative", "kpi", "baseline", "target", "owner", "timing", "dependency", "implementation_cost", "milestone", "stop_rule", "value", "credit_classification", "risk", "lineage"],
        "properties": {
          "priority": {"type": "integer", "minimum": 1, "maximum": 5},
          "initiative": {"type": "string", "minLength": 1},
          "kpi": {"type": "string", "minLength": 1},
          "baseline": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "timing": {"type": "string", "minLength": 1},
          "dependency": {"type": "string", "minLength": 1},
          "implementation_cost": {"type": "string", "minLength": 1},
          "milestone": {"type": "string", "minLength": 1},
          "stop_rule": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "credit_classification": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "minLength": 1},
          "lineage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "screenedOutLevers": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lever", "evidence_state", "reason_screened_out", "reconsideration_trigger"],
        "properties": {
          "lever": {"type": "string", "minLength": 1},
          "evidence_state": {"type": "string", "minLength": 1},
          "reason_screened_out": {"type": "string", "minLength": 1},
          "reconsideration_trigger": {"type": "string", "minLength": 1}
        }
      }
    },
    "lineage": {"type": "array", "minItems": 1},
    "artifacts": {"type": "array", "minItems": 1},
    "temporalScan": {"type": "object"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenarioBook": {"type": "object"},
    "thesisGraph": {"type": "object"},
    "sourceLocators": {"type": "array", "minItems": 1},
    "formulaRegistry": {"type": "array"},
    "metricRegistry": {"type": "array", "minItems": 1},
    "renderManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "metric_ids", "investment_metric_ids", "formula_sample_metric_ids"],
      "properties": {
        "schema_version": {"const": "underwriting.render-manifest/v2"},
        "metric_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "investment_metric_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "formula_sample_metric_ids": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

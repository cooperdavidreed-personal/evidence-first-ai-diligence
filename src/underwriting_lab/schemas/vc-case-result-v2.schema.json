{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailyaiagents.dev/schemas/vc-case-result-v2.schema.json",
  "title": "VC Case Result v2",
  "type": "object",
  "required": ["schema_version", "scenario_id", "engine_inputs_sha256", "financing_events", "holders", "preferences", "cash_by_month", "waterfall", "target_invested_cents", "target_proceeds_cents", "target_cash_flows", "target_ownership", "gross_moic", "gross_xirr", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.vc-scenario-result/v2"},
    "scenario_id": {"enum": ["BASE", "MILESTONE", "DOWNSIDE", "FINANCING_SHORTFALL"]},
    "engine_inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "financing_events": {"type": "array", "minItems": 2},
    "holders": {"type": "array", "minItems": 4},
    "preferences": {"type": "array", "minItems": 3},
    "cash_by_month": {"type": "array", "minItems": 60, "maxItems": 60},
    "waterfall": {"type": "object"},
    "target_invested_cents": {"type": "integer", "minimum": 1},
    "target_proceeds_cents": {"type": "integer", "minimum": 0},
    "target_cash_flows": {"type": "array", "minItems": 2},
    "target_ownership": {"type": "string"},
    "gross_moic": {"type": "string"},
    "gross_xirr": {"type": "string"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

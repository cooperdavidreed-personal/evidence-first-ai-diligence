{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cooperdavidreed-personal.github.io/evidence-first-ai-diligence/schemas/dataroom-manifest.schema.json",
  "title": "Synthetic data-room manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "synthetic", "disclosure", "contract_version", "cutoff", "seed_commitment", "generator", "artifacts", "analysis_specs", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "underwriting.dataroom-manifest/v1"},
    "case_id": {"enum": ["atlasgrid", "helios"]},
    "synthetic": {"const": true},
    "disclosure": {"const": "SYNTHETIC — NOT INVESTMENT ADVICE"},
    "contract_version": {"const": "underwriting-econometrics/v1"},
    "cutoff": {"type": "string", "format": "date-time"},
    "seed_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator": {"const": "underwriting_lab.generator/v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "schema", "rows", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^data/"},
          "schema": {"type": "string", "minLength": 3},
          "rows": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "analysis_specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "analysis_id", "cutoff", "tolerance_policy", "state_policy", "method_family", "recovery_rule", "design", "spec_sha256"],
        "properties": {
          "schema_version": {"const": "underwriting.analysis-spec/v2"},
          "analysis_id": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]{2}$"},
          "cutoff": {"type": "string", "format": "date-time"},
          "tolerance_policy": {"type": "string"},
          "state_policy": {"type": "string"},
          "method_family": {"type": "string", "minLength": 1},
          "recovery_rule": {"type": "string", "minLength": 1},
          "design": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "treatment_or_exposure", "population", "period", "estimand", "unit", "assignment_or_design", "uncertainty_method", "required_diagnostics", "permitted_use"],
            "properties": {
              "outcome": {"type": "string", "minLength": 1},
              "treatment_or_exposure": {"type": "string", "minLength": 1},
              "population": {"type": "string", "minLength": 1},
              "period": {"type": "string", "minLength": 1},
              "estimand": {"type": "string", "minLength": 1},
              "unit": {"type": "string", "minLength": 1},
              "assignment_or_design": {"type": "string", "minLength": 1},
              "uncertainty_method": {"type": "string", "minLength": 1},
              "required_diagnostics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "permitted_use": {"type": "string", "minLength": 1}
            }
          },
          "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ic-evidence-lab/case.schema.json",
  "title": "IC Evidence Lab Case",
  "type": "object",
  "required": ["schema_version", "case_id", "company", "as_of", "generated_at", "sources", "claims", "open_questions"],
  "properties": {
    "schema_version": {"const": "ic-evidence-lab.case/v1"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "company": {"type": "string", "minLength": 1, "maxLength": 200},
    "as_of": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/$defs/claim"}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "required": ["source_id", "quote", "locator"],
      "properties": {"source_id":{"type":"string"},"quote":{"type":"string"},"locator":{"type":"string"}},
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "uri", "source_type", "tier", "published_at", "retrieved_at", "path", "sha256"],
      "properties": {
        "source_id":{"type":"string"},"uri":{"type":"string"},"source_type":{"type":"string"},
        "tier":{"enum":["A","B","C","D"]},"published_at":{"type":"string","format":"date"},
        "retrieved_at":{"type":"string","format":"date-time"},"path":{"type":"string"},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "statement", "kind", "materiality", "evidence", "counterevidence"],
      "properties": {
        "claim_id":{"type":"string"},"statement":{"type":"string"},
        "kind":{"enum":["fact","derived","judgment"]},
        "materiality":{"enum":["high","medium","low"]},
        "evidence":{"type":"array","items":{"$ref":"#/$defs/span"}},
        "counterevidence":{"type":"array","items":{"$ref":"#/$defs/span"}},
        "calculation":{"type":"object"}
      },
      "additionalProperties": false
    }
  }
}

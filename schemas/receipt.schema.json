{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ic-evidence-lab/receipt.schema.json",
  "title": "IC Evidence Lab Receipt",
  "type": "object",
  "required": ["schema_version", "case_id", "status", "workflow_disposition", "investment_decision", "claim_state_counts", "packet_sha256", "limitations"],
  "properties": {
    "schema_version":{"const":"ic-evidence-lab.receipt/v1"},
    "status":{"enum":["PASS","BLOCKED"]},
    "investment_decision":{"const":"PENDING_HUMAN"},
    "packet_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
